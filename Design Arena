@charset "utf-8";

:root { --ink: #171b19; --ink-soft: #222825; --paper: #f5f3ed; --paper-dark: #eae7df; --white: #fffefa; --muted: #777b73; --gold: #c2a575; --gold-light: #dfc99f; --line: rgba(23, 27, 25, .14); --serif: Georgia, "Times New Roman", serif; --sans: "Manrope", "DM Sans", sans-serif; --ease: cubic-bezier(.22,.61,.36,1); }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 86px; }

body { margin: 0px; background: var(--paper); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; overflow-x: hidden; }

img { display: block; max-width: 100%; }

a { color: inherit; text-decoration: none; }

button, input, textarea { font: inherit; }

button, a { -webkit-tap-highlight-color: transparent; }

.wrap { width: min(1200px, 100% - 64px); margin-inline: auto; }

.eyebrow { display: flex; align-items: center; gap: 12px; color: var(--gold); font-size: 10px; font-weight: 700; letter-spacing: 0.21em; text-transform: uppercase; }

.eyebrow::before { content: ""; width: 27px; height: 1px; background: currentcolor; }

.section-title { margin: 17px 0px 0px; font-size: clamp(36px, 5vw, 66px); letter-spacing: -0.055em; line-height: 1.04; font-weight: 500; }

.section-title em { font-family: var(--serif); font-weight: 400; }

.body-copy { color: var(--muted); line-height: 1.85; font-size: 14px; }

.btn { min-height: 54px; padding: 0px 24px; display: inline-flex; align-items: center; justify-content: center; gap: 12px; border: 1px solid transparent; text-transform: uppercase; letter-spacing: 0.11em; font-size: 10px; font-weight: 700; transition: color 0.3s, background 0.3s, border-color 0.3s, transform 0.3s; cursor: pointer; }

.btn:hover { transform: translateY(-2px); }

.btn-gold { background: var(--gold); color: var(--ink); }

.btn-gold:hover { background: var(--gold-light); }

.btn-outline { border-color: rgba(255, 255, 255, 0.48); color: white; }

.btn-outline:hover { border-color: var(--gold-light); color: var(--gold-light); }

.btn-dark { background: var(--ink); color: white; }

.btn-dark:hover { background: rgb(48, 54, 49); }

.arrow { font-size: 16px; line-height: 1; transition: transform 0.25s; }

.btn:hover .arrow { transform: translateX(4px); }

.navbar { position: fixed; inset: 0px 0px auto; z-index: 100; height: 78px; color: white; border-bottom: 1px solid rgba(255, 255, 255, 0.16); transition: background 0.35s, height 0.35s, box-shadow 0.35s; }

.navbar.scrolled { height: 68px; background: rgba(23, 27, 25, 0.96); backdrop-filter: blur(14px); box-shadow: rgba(0, 0, 0, 0.12) 0px 8px 30px; border-color: rgba(255, 255, 255, 0.08); }

.nav-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; }

.brand { display: flex; align-items: center; gap: 12px; min-width: 245px; }

.brand-mark { width: 35px; height: 35px; display: grid; place-items: center; border: 1px solid rgba(223, 201, 159, 0.8); color: var(--gold-light); font-family: var(--serif); font-size: 21px; transform: rotate(45deg); }

.brand-mark span { transform: rotate(-45deg); }

.brand-name { font-size: 11px; letter-spacing: 0.17em; font-weight: 700; line-height: 1.45; }

