@charset "utf-8";

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

:root { --bg: #0c0b0a; --bg-elevated: #141210; --bg-card: #1a1814; --bg-soft: #f7f4ef; --bg-warm: #ebe6de; --text: #f5f0e8; --text-muted: #a89f91; --text-dark: #1a1814; --text-dark-muted: #5c564c; --accent: #c4a574; --accent-light: #d4bc94; --accent-dark: #9a7b4f; --gold-gradient: linear-gradient(135deg,#c4a574 0%,#e8d5b0 50%,#c4a574 100%); --border: rgba(196,165,116,0.18); --border-light: rgba(196,165,116,0.08); --glass: rgba(20,18,16,0.72); --shadow: 0 24px 64px rgba(0,0,0,0.45); --radius: 2px; --nav-h: 72px; --ease: cubic-bezier(0.22,1,0.36,1); --font-display: 'Cormorant Garamond',Georgia,serif; --font-body: 'Outfit',system-ui,sans-serif; }

html { scroll-behavior: smooth; font-size: 16px; }

body { font-family: var(--font-body); background: var(--bg); color: var(--text); line-height: 1.6; overflow-x: hidden; -webkit-font-smoothing: antialiased; }

img { max-width: 100%; display: block; height: auto; }

a { text-decoration: none; color: inherit; }

button, input, textarea { font-family: inherit; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; outline: none; }

ul { list-style: none; }

.container { width: 100%; max-width: 1200px; margin: 0px auto; padding: 0px 24px; }

.container-wide { width: 100%; max-width: 1400px; margin: 0px auto; padding: 0px 24px; }

.nav { position: fixed; top: 0px; left: 0px; right: 0px; z-index: 1000; height: var(--nav-h); display: flex; align-items: center; transition: background 0.4s var(--ease),backdrop-filter 0.4s var(--ease),box-shadow 0.4s var(--ease); }

.nav.scrolled { background: var(--glass); backdrop-filter: blur(20px) saturate(1.4); box-shadow: 0 1px 0 var(--border-light); }

.nav-inner { width: 100%; max-width: 1400px; margin: 0px auto; padding: 0px 24px; display: flex; align-items: center; justify-content: space-between; }

.nav-logo { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; letter-spacing: 0.12em; color: var(--text); display: flex; align-items: center; gap: 10px; }

.nav-logo span { color: var(--accent); }

.nav-logo-line { width: 28px; height: 1px; background: var(--accent); display: inline-block; }

.nav-links { display: flex; align-items: center; gap: 36px; }

.nav-links a { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); transition: color 0.3s; position: relative; }

.nav-links a::after { content: ""; position: absolute; bottom: -4px; left: 0px; width: 0px; height: 1px; background: var(--accent); transition: width 0.3s var(--ease); }

.nav-links a:hover { color: var(--text); }

.nav-links a:hover::after { width: 100%; }

.nav-cta { display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; background: transparent; border: 1px solid var(--accent); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; transition: background 0.3s, color 0.3s; color: var(--accent) !important; font-size: 0.72rem !important; }

.nav-cta::after { display: none !important; }

.nav-cta:hover { background: var(--accent); color: var(--bg) !important; }

.nav-toggle { display: none; flex-direction: column; gap: 6px; background: none; cursor: pointer; padding: 8px; z-index: 1001; }

.nav-toggle span { display: block; width: 24px; height: 1.5px; background: var(--text); transition: transform 0.3s, opacity 0.3s; }

.nav-toggle.active span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }

.nav-toggle.active span:nth-child(2) { opacity: 0; }

.nav-toggle.active span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

.mobile-menu { position: fixed; inset: 0px; z-index: 999; background: rgba(12, 11, 10, 0.97); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; opacity: 0; visibility: hidden; transition: opacity 0.4s, visibility 0.4s; }

.mobile-menu.open { opacity: 1; visibility: visible; }

.mobile-menu a { font-family: var(--font-display); font-size: 2rem; font-weight: 500; letter-spacing: 0.08em; color: var(--text-muted); transition: color 0.3s; }

.mobile-menu a:hover { color: var(--accent); }

.mobile-menu-phone { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border); font-size: 1rem; letter-spacing: 0.1em; color: var(--accent); }

.hero { position: relative; min-height: 100dvh; display: flex; align-items: flex-end; overflow: hidden; }

.hero-bg { position: absolute; inset: 0px; z-index: 0; }

.hero-bg img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.05); animation: 20s ease-out 0s 1 normal forwards running heroZoom; }

@keyframes heroZoom { 
  100% { transform: scale(1); }
}

.hero-overlay { position: absolute; inset: 0px; z-index: 1; background: linear-gradient(rgba(12, 11, 10, 0.45) 0%, rgba(12, 11, 10, 0.25) 35%, rgba(12, 11, 10, 0.75) 70%, rgba(12, 11, 10, 0.95) 100%), linear-gradient(90deg, rgba(12, 11, 10, 0.55) 0%, transparent 50%); }

.hero-content { position: relative; z-index: 2; width: 100%; max-width: 1400px; margin: 0px auto; padding: 0px 24px 100px; }

.hero-badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; border: 1px solid var(--accent); background: rgba(196, 165, 116, 0.1); margin-bottom: 28px; opacity: 0; transform: translateY(20px); animation: fadeUp 0.8s var(--ease) 0.3s forwards; }

.hero-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: 2s ease-in-out 0s infinite normal none running pulse; }

@keyframes pulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.hero-badge span { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }

.hero-title { font-family: var(--font-display); font-size: clamp(2.8rem, 7vw, 5.5rem); font-weight: 600; line-height: 1.05; letter-spacing: 0.04em; color: var(--text); margin-bottom: 16px; opacity: 0; transform: translateY(30px); animation: fadeUp 0.9s var(--ease) 0.5s forwards; }

.hero-subtitle { font-family: var(--font-display); font-style: italic; font-size: clamp(1.15rem, 2.5vw, 1.6rem); font-weight: 400; color: var(--accent-light); margin-bottom: 20px; letter-spacing: 0.02em; opacity: 0; transform: translateY(20px); animation: fadeUp 0.8s var(--ease) 0.7s forwards; }

.hero-location { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; font-weight: 400; color: var(--text-muted); letter-spacing: 0.04em; margin-bottom: 40px; opacity: 0; transform: translateY(20px); animation: fadeUp 0.8s var(--ease) 0.85s forwards; }

.hero-location svg { width: 16px; height: 16px; stroke: var(--accent); flex-shrink: 0; }

.hero-actions { display: flex; flex-wrap: wrap; gap: 16px; opacity: 0; transform: translateY(20px); animation: fadeUp 0.8s var(--ease) 1s forwards; }

@keyframes fadeUp { 
  100% { opacity: 1; transform: translateY(0px); }
}

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 16px 32px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; transition: all 0.35s var(--ease); border: 1px solid transparent; position: relative; overflow: hidden; }

.btn-primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }

.btn-primary:hover { background: var(--accent-light); border-color: var(--accent-light); transform: translateY(-2px); box-shadow: rgba(196, 165, 116, 0.3) 0px 12px 32px; }

.btn-secondary { background: transparent; color: var(--text); border-color: rgba(245, 240, 232, 0.35); }

.btn-secondary:hover { border-color: var(--text); background: rgba(245, 240, 232, 0.06); transform: translateY(-2px); }

.btn-outline-gold { background: transparent; color: var(--accent); border-color: var(--accent); }

.btn-outline-gold:hover { background: var(--accent); color: var(--bg); transform: translateY(-2px); box-shadow: rgba(196, 165, 116, 0.25) 0px 12px 32px; }

.btn-dark { background: var(--text-dark); color: var(--text); border-color: var(--text-dark); }

.btn-dark:hover { background: var(--bg-card); transform: translateY(-2px); }

.btn svg { width: 16px; height: 16px; }

.section { padding: 100px 0px; position: relative; }

.section-label { display: inline-flex; align-items: center; gap: 12px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin-bottom: 16px; }

.section-label::before { content: ""; width: 32px; height: 1px; background: var(--accent); }

.section-title { font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 600; line-height: 1.15; letter-spacing: 0.02em; margin-bottom: 20px; }

.section-desc { font-size: 1.05rem; line-height: 1.75; color: var(--text-muted); max-width: 540px; }

.reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.9s var(--ease),transform 0.9s var(--ease); }

.reveal.visible { opacity: 1; transform: translateY(0px); }

.reveal-delay-1 { transition-delay: 0.1s; }

.reveal-delay-2 { transition-delay: 0.2s; }

.reveal-delay-3 { transition-delay: 0.3s; }

.reveal-delay-4 { transition-delay: 0.4s; }

.project-section { background: var(--bg); }

.project-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }

.project-visual { position: relative; aspect-ratio: 4 / 5; overflow: hidden; }

.project-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }

.project-visual:hover img { transform: scale(1.04); }

.project-visual-accent { position: absolute; bottom: -20px; right: -20px; width: 60%; height: 60%; border: 1px solid var(--border); z-index: -1; }

.project-content .section-title { color: var(--text); }

.project-points { margin-top: 40px; display: grid; gap: 24px; }

.project-point { display: flex; gap: 20px; align-items: flex-start; padding-bottom: 24px; border-bottom: 1px solid var(--border-light); }

.project-point:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; padding-bottom: 0px; }

.project-point-num { font-family: var(--font-display); font-size: 1.4rem; font-weight: 500; color: var(--accent); line-height: 1; min-width: 36px; }

.project-point h4 { font-size: 0.95rem; font-weight: 600; letter-spacing: 0.04em; color: var(--text); margin-bottom: 6px; }

.project-point p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.65; }

.location-section { background: var(--bg-elevated); overflow: hidden; }

.location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }

.location-map { position: relative; aspect-ratio: 1 / 1; background: var(--bg-card); border: 1px solid var(--border); overflow: hidden; }

.location-map-inner { position: absolute; inset: 0px; background: radial-gradient(circle at 55% 48%,rgba(196,165,116,0.12) 0%,transparent 50%),
linear-gradient(180deg,var(--bg-card) 0%,var(--bg) 100%); display: flex; align-items: center; justify-content: center; }

.map-grid-lines { position: absolute; inset: 0px; opacity: 0.15; background-image: linear-gradient(rgba(196, 165, 116, 0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(196, 165, 116, 0.4) 1px, transparent 1px); background-size: 40px 40px; }

.map-pin { position: relative; z-index: 2; text-align: center; animation: 3s ease-in-out 0s infinite normal none running pinFloat; }

@keyframes pinFloat { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-8px); }
}

.map-pin-icon { width: 48px; height: 48px; margin: 0px auto 16px; background: var(--accent); border-radius: 50% 50% 50% 0px; transform: rotate(-45deg); display: flex; align-items: center; justify-content: center; box-shadow: rgba(196, 165, 116, 0.4) 0px 8px 32px; }

.map-pin-icon svg { transform: rotate(45deg); width: 20px; height: 20px; stroke: var(--bg); fill: none; }

.map-pin-label { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--text); letter-spacing: 0.04em; }

.map-pin-sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 4px; letter-spacing: 0.06em; }

.map-rings { position: absolute; top: 50%; left: 55%; transform: translate(-50%, -50%); }

.map-ring { position: absolute; border: 1px solid rgba(196, 165, 116, 0.2); border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -50%); animation: 4s ease-out 0s infinite normal none running ringPulse; }

.map-ring:nth-child(1) { width: 120px; height: 120px; animation-delay: 0s; }

.map-ring:nth-child(2) { width: 200px; height: 200px; animation-delay: 1s; }

.map-ring:nth-child(3) { width: 300px; height: 300px; animation-delay: 2s; }

@keyframes ringPulse { 
  0% { opacity: 0.6; transform: translate(-50%, -50%) scale(0.85); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.1); }
}

.location-details { display: flex; flex-direction: column; gap: 32px; }

.location-card { padding: 28px 32px; background: rgba(196, 165, 116, 0.04); border: 1px solid var(--border); transition: border-color 0.3s, background 0.3s; }

.location-card:hover { border-color: rgba(196, 165, 116, 0.35); background: rgba(196, 165, 116, 0.07); }

.location-card h4 { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }

.location-card p { font-size: 1.05rem; color: var(--text); line-height: 1.5; font-family: var(--font-display); font-weight: 500; }

.location-address-block { margin-top: 8px; }

.location-address-block .main-addr { font-family: var(--font-display); font-size: 1.8rem; font-weight: 600; color: var(--text); line-height: 1.3; margin-bottom: 8px; }

.location-address-block .city { font-size: 1rem; color: var(--text-muted); letter-spacing: 0.06em; }

.lifestyle-section { background: var(--bg-soft); color: var(--text-dark); }

.lifestyle-section .section-label { color: var(--accent-dark); }

.lifestyle-section .section-label::before { background: var(--accent-dark); }

.lifestyle-header { text-align: center; max-width: 640px; margin: 0px auto 64px; }

.lifestyle-header .section-title { color: var(--text-dark); }

.lifestyle-header .section-desc { color: var(--text-dark-muted); margin: 0px auto; }

.lifestyle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }

.lifestyle-card { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: var(--bg-card); }

.lifestyle-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }

.lifestyle-card:hover img { transform: scale(1.06); }

.lifestyle-card-overlay { position: absolute; inset: 0px; background: linear-gradient(transparent 30%, rgba(12, 11, 10, 0.85) 100%); display: flex; flex-direction: column; justify-content: flex-end; padding: 32px 28px; }

.lifestyle-card h3 { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; color: var(--text); margin-bottom: 8px; letter-spacing: 0.03em; }

.lifestyle-card p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.55; }

.lifestyle-wide { grid-column: span 2; aspect-ratio: auto; min-height: 320px; }

.lifestyle-statement { text-align: center; padding: 80px 24px 0px; max-width: 700px; margin: 0px auto; }

.lifestyle-statement blockquote { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); font-style: italic; font-weight: 400; line-height: 1.5; color: var(--text-dark); letter-spacing: 0.01em; }

.lifestyle-statement cite { display: block; margin-top: 20px; font-size: 0.72rem; font-style: normal; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-dark); font-family: var(--font-body); }

.booking-section { position: relative; padding: 120px 0px; background: var(--bg); overflow: hidden; }

.booking-bg { position: absolute; inset: 0px; z-index: 0; }

.booking-bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.25; }

.booking-bg-overlay { position: absolute; inset: 0px; background: linear-gradient(180deg,var(--bg) 0%,rgba(12,11,10,0.85) 40%,rgba(12,11,10,0.92) 100%); }

.booking-content { position: relative; z-index: 2; text-align: center; max-width: 720px; margin: 0px auto; }

.booking-content .section-title { font-size: clamp(2.2rem, 5vw, 3.6rem); margin-bottom: 16px; }

.booking-badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 20px; margin-bottom: 28px; border: 1px solid var(--accent); background: rgba(196, 165, 116, 0.1); }

.booking-badge span { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }

.booking-info { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 48px 0px; padding: 36px 0px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

.booking-info-item h4 { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }

.booking-info-item p { font-size: 1rem; color: var(--text); font-weight: 500; line-height: 1.4; }

.booking-info-item a { color: var(--text); transition: color 0.3s; }

.booking-info-item a:hover { color: var(--accent); }

.booking-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }

.contact-section { background: var(--bg-elevated); padding: 100px 0px; }

.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }

.contact-info-side .section-title { margin-bottom: 16px; }

.contact-details { margin-top: 40px; display: flex; flex-direction: column; gap: 28px; }

.contact-detail { display: flex; gap: 16px; align-items: flex-start; }

.contact-detail-icon { width: 44px; height: 44px; flex-shrink: 0; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; }

.contact-detail-icon svg { width: 18px; height: 18px; stroke: var(--accent); }

.contact-detail h4 { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }

.contact-detail p, .contact-detail a { font-size: 1.05rem; color: var(--text); font-weight: 400; }

.contact-detail a:hover { color: var(--accent); }

.contact-form-wrap { background: var(--bg-card); border: 1px solid var(--border); padding: 40px 36px; }

.contact-form-wrap h3 { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; margin-bottom: 8px; letter-spacing: 0.02em; }

.contact-form-wrap > p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 32px; }

.form-group { margin-bottom: 20px; }

.form-group label { display: block; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px; }

.form-group input, .form-group textarea { width: 100%; padding: 14px 16px; background: rgba(12, 11, 10, 0.5); border: 1px solid var(--border); color: var(--text); font-size: 0.95rem; transition: border-color 0.3s; border-radius: var(--radius); }

.form-group input:focus, .form-group textarea:focus { border-color: var(--accent); }

.form-group input::placeholder, .form-group textarea::placeholder { color: rgba(168, 159, 145, 0.5); }

.form-group textarea { resize: vertical; min-height: 110px; }

.form-submit { width: 100%; margin-top: 8px; }

.form-success { display: none; text-align: center; padding: 40px 20px; }

.form-success.visible { display: block; }

.form-success svg { width: 48px; height: 48px; stroke: var(--accent); margin: 0px auto 16px; }

.form-success h4 { font-family: var(--font-display); font-size: 1.5rem; margin-bottom: 8px; }

.form-success p { color: var(--text-muted); font-size: 0.95rem; }

.footer { background: var(--bg); border-top: 1px solid var(--border-light); padding: 48px 0px 100px; }

.footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; }

.footer-brand { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: 0.1em; color: var(--text); }

.footer-brand span { color: var(--accent); }

.footer-copy { font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.02em; }

.footer-phone a { font-size: 0.9rem; font-weight: 500; color: var(--accent); letter-spacing: 0.06em; transition: color 0.3s; }

.footer-phone a:hover { color: var(--accent-light); }

.mobile-bar { display: none; position: fixed; bottom: 0px; left: 0px; right: 0px; z-index: 1000; background: var(--glass); backdrop-filter: blur(20px); border-top: 1px solid var(--border); padding-top: 12px; padding-right: 16px; padding-left: 16px; padding-bottom: max(12px,env(safe-area-inset-bottom)); gap: 10px; }

.mobile-bar .btn { flex: 1 1 0%; padding: 14px 12px; font-size: 0.72rem; }

.gold-line { width: 60px; height: 1px; background: var(--gold-gradient); margin: 20px 0px; }

@media (max-width: 968px) {
  .nav-links { display: none; }
