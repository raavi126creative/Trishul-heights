@charset "utf-8";

:root { --ink: #13201d; --ink-2: #20322d; --sand: #e8dfd1; --ivory: #f7f4ee; --gold: #c69b61; --gold-light: #e9cf9f; --line: rgba(19,32,29,.14); --white: #fffdf9; --muted: #66716c; --shadow: 0 20px 70px rgba(13,25,21,.14); }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--ivory); color: var(--ink); font-family: Arial, Helvetica, sans-serif; overflow-x: hidden; -webkit-font-smoothing: antialiased; }

h1, h2, h3, p { margin: 0px; }

a { text-decoration: none; color: inherit; }

button, input, textarea { font: inherit; }

.serif { font-family: Georgia, "Times New Roman", serif; }

.eyebrow { display: flex; align-items: center; gap: 11px; color: var(--gold); letter-spacing: 0.16em; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; }

.eyebrow::before { content: ""; display: inline-block; width: 29px; height: 1px; background: currentcolor; }

.section { padding: 120px max(5.5vw, 24px); }

.section-heading { font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.2rem, 4.1vw, 4.35rem); line-height: 1.06; font-weight: 400; letter-spacing: -0.045em; }

.copy { color: var(--muted); font-size: 1rem; line-height: 1.8; }

.button { min-height: 54px; padding: 0px 25px; display: inline-flex; align-items: center; justify-content: center; gap: 13px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; border: 1px solid transparent; cursor: pointer; transition: 0.3s; white-space: nowrap; }

.button svg { width: 16px; height: 16px; transition: transform 0.3s; }

.button:hover svg { transform: translateX(4px); }

.button-primary { background: var(--gold); color: rgb(22, 32, 29); }

.button-primary:hover { background: var(--gold-light); box-shadow: rgba(198, 155, 97, 0.25) 0px 12px 30px; transform: translateY(-2px); }

.button-outline { border-color: rgba(255, 255, 255, 0.48); color: white; background: rgba(255, 255, 255, 0.03); }

.button-outline:hover { background: white; color: var(--ink); border-color: white; }

.button-dark { background: var(--ink); color: rgb(255, 255, 255); }

.button-dark:hover { background: var(--ink-2); transform: translateY(-2px); }

.nav { position: fixed; z-index: 20; top: 0px; left: 0px; width: 100%; height: 84px; padding: 0px max(5.5vw, 24px); display: flex; align-items: center; justify-content: space-between; color: white; transition: background 0.35s, box-shadow 0.35s, height 0.35s; }

.nav.scrolled { height: 70px; background: rgba(19, 32, 29, 0.94); backdrop-filter: blur(17px); box-shadow: rgba(0, 0, 0, 0.12) 0px 3px 20px; }

.brand { display: flex; align-items: center; gap: 11px; font-family: Georgia, serif; letter-spacing: 0.12em; font-size: 0.86rem; font-weight: bold; }

.brand-mark { height: 26px; width: 20px; position: relative; border-left: 1px solid var(--gold); border-right: 1px solid var(--gold); }

.brand-mark::before { content: ""; position: absolute; top: 0px; left: 3px; width: 10px; height: 10px; border-top: 1px solid var(--gold); border-left: 1px solid var(--gold); transform: rotate(45deg); }

.brand-mark::after { content: ""; position: absolute; bottom: 0px; left: 3px; width: 11px; height: 15px; border-top: 1px solid var(--gold); }

.nav-links { display: flex; align-items: center; gap: 28px; font-size: 0.67rem; letter-spacing: 0.12em; font-weight: bold; }

.nav-links a { opacity: 0.77; transition: 0.25s; }

.nav-links a:hover { opacity: 1; color: var(--gold-light); }

.nav-cta { color: var(--gold-light); border-bottom: 1px solid var(--gold); padding-bottom: 5px; }

.menu-btn { display: none; border: 0px; background: none; color: white; padding: 10px 0px; cursor: pointer; }

.menu-btn span { display: block; background: currentcolor; height: 1px; width: 26px; margin: 6px 0px; }

.hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: white; overflow: hidden; padding: 0px max(5.5vw, 24px) 72px; background: rgb(24, 34, 31); }

.hero-image { position: absolute; inset: 0px; background-image: linear-gradient(90deg, rgba(10, 20, 17, 0.72) 0%, rgba(10, 20, 17, 0.32) 50%, rgba(10, 20, 17, 0.17)), linear-gradient(0deg, rgba(10, 20, 17, 0.69), transparent 48%), url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2200&q=88"); background-size: cover; background-position: center center; transform: scale(1.05); animation: 15s ease-out 0s 1 normal forwards running heroImage; }

@keyframes heroImage { 
  100% { transform: scale(1); }
}

.hero-grid { position: absolute; inset: 0px; opacity: 0.2; background-image: linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px); background-size: 90px 90px; mask-image: linear-gradient(90deg, black, transparent 70%); }

.hero-content { position: relative; width: min(800px, 100%); padding-top: 125px; }

.status { display: inline-flex; align-items: center; gap: 9px; background: rgba(198, 155, 97, 0.95); color: rgb(23, 33, 30); padding: 9px 13px; font-size: 0.66rem; font-weight: 900; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 24px; animation: 0.7s ease 0.1s 1 normal both running rise; }

.status i { width: 7px; height: 7px; border-radius: 50%; background: rgb(29, 52, 43); display: block; }

.hero h1 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(3rem, 7.1vw, 7.4rem); font-weight: 400; line-height: 0.91; letter-spacing: -0.065em; animation: 0.9s ease 0.2s 1 normal both running rise; }

.hero-sub { font-family: Georgia, serif; font-size: clamp(1.13rem, 2vw, 1.55rem); margin-top: 23px; color: rgb(244, 238, 227); animation: 0.9s ease 0.36s 1 normal both running rise; }

.hero-location { display: flex; align-items: center; gap: 10px; margin-top: 27px; color: rgb(216, 221, 217); font-size: 0.88rem; animation: 0.9s ease 0.48s 1 normal both running rise; }

.pin { color: var(--gold-light); width: 17px; flex: 0 0 auto; }

.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 35px; animation: 0.9s ease 0.6s 1 normal both running rise; }

.hero-side { position: absolute; right: max(5.5vw, 24px); bottom: 76px; display: flex; flex-direction: column; align-items: flex-end; gap: 16px; animation: 1s ease 0.7s 1 normal both running rise; }

.hero-side small { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.59rem; opacity: 0.7; writing-mode: vertical-rl; }

.scroll-line { height: 77px; width: 1px; background: linear-gradient(var(--gold),transparent); }

@keyframes rise { 
  0% { opacity: 0; transform: translateY(21px); }
  100% { opacity: 1; transform: none; }
}

.intro { display: grid; grid-template-columns: 1fr 1.18fr; gap: clamp(40px, 9vw, 150px); align-items: end; }

.intro-right { padding-bottom: 5px; }

.intro-right .copy { max-width: 575px; margin-top: 29px; }

.mini-detail { display: flex; align-items: flex-start; gap: 15px; margin-top: 37px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 0.86rem; line-height: 1.6; }

.mini-detail strong { color: var(--gold); font-size: 0.68rem; letter-spacing: 0.13em; text-transform: uppercase; min-width: 88px; }

.project { background: var(--ink); color: white; position: relative; overflow: hidden; }

.project::after { content: ""; position: absolute; width: 60vw; height: 60vw; right: -25vw; top: -24vw; border: 1px solid rgba(198, 155, 97, 0.2); border-radius: 50%; }

.project-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 8vw; align-items: center; }

.project-copy .section-heading { max-width: 600px; }

.project-copy .copy { max-width: 520px; color: rgb(200, 207, 203); margin-top: 28px; }

.project-note { margin-top: 38px; padding: 21px 0px; border-top: 1px solid rgba(255, 255, 255, 0.16); border-bottom: 1px solid rgba(255, 255, 255, 0.16); font-family: Georgia, serif; font-size: 1.18rem; line-height: 1.5; color: rgb(243, 237, 228); }

.project-image { height: 550px; position: relative; overflow: hidden; }

.project-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.7); }

.image-label { position: absolute; bottom: 0px; left: 0px; background: var(--gold); color: var(--ink); padding: 13px 16px; font-size: 0.61rem; font-weight: bold; letter-spacing: 0.14em; text-transform: uppercase; }

.location { background: rgb(237, 231, 220); }

.location-top { display: flex; justify-content: space-between; gap: 40px; align-items: end; margin-bottom: 55px; }

.location-top .copy { max-width: 385px; }

.map-wrap { height: 495px; position: relative; background: rgb(213, 219, 212); overflow: hidden; border: 1px solid rgba(19, 32, 29, 0.1); }

.map-pattern { position: absolute; inset: -15%; background: linear-gradient(118deg, transparent 47%, rgba(255, 255, 255, 0.72) 47.3%, rgba(255, 255, 255, 0.72) 50%, transparent 50.3%), linear-gradient(20deg, transparent 42%, rgba(255, 255, 255, 0.6) 42.3%, rgba(255, 255, 255, 0.6) 45%, transparent 45.3%), linear-gradient(75deg, transparent 58%, rgba(255, 255, 255, 0.48) 58.3%, rgba(255, 255, 255, 0.48) 60%, transparent 60.3%), repeating-linear-gradient(0deg, rgba(80, 107, 92, 0.1) 0px, rgba(80, 107, 92, 0.1) 1px, transparent 1px, transparent 58px), repeating-linear-gradient(90deg, rgba(80, 107, 92, 0.1) 0px, rgba(80, 107, 92, 0.1) 1px, transparent 1px, transparent 79px); transform: rotate(-4deg); opacity: 0.9; }

.map-park { position: absolute; width: 50%; height: 57%; right: -5%; top: -12%; background: rgb(169, 191, 165); border-radius: 44% 55% 43% 52%; opacity: 0.7; }

.map-park::after { content: ""; position: absolute; inset: 19%; border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 50%; }

.map-street { position: absolute; font-size: 0.57rem; letter-spacing: 0.11em; font-weight: bold; text-transform: uppercase; color: rgb(103, 118, 110); transform: rotate(-5deg); }

.s1 { top: 30%; left: 7%; }

.s2 { right: 15%; bottom: 20%; transform: rotate(70deg); }

.location-card { position: absolute; left: clamp(20px, 5vw, 70px); bottom: clamp(20px, 5vw, 62px); background: rgba(255, 253, 249, 0.95); backdrop-filter: blur(10px); padding: 28px; max-width: 375px; box-shadow: var(--shadow); }

.location-card .eyebrow { font-size: 0.58rem; }

.location-card h3 { font-family: Georgia, serif; font-size: 1.55rem; font-weight: 400; line-height: 1.23; margin-top: 13px; }

.location-card p { font-size: 0.83rem; color: var(--muted); margin-top: 12px; line-height: 1.6; }

.map-marker { position: absolute; left: 58%; top: 47%; z-index: 2; width: 53px; height: 53px; background: var(--ink); border: 7px solid rgba(198, 155, 97, 0.85); border-radius: 50% 50% 50% 0px; transform: rotate(-45deg); box-shadow: rgba(0, 0, 0, 0.22) 0px 8px 20px; }

.map-marker span { display: block; position: absolute; width: 11px; height: 11px; background: var(--gold-light); border-radius: 50%; top: 14px; left: 14px; }

.lifestyle { padding-bottom: 0px; }

.lifestyle-head { max-width: 690px; margin-bottom: 58px; }

.lifestyle-head .copy { margin-top: 20px; max-width: 500px; }

.lifestyle-grid { display: grid; grid-template-columns: 1.15fr 0.85fr 0.85fr; grid-template-rows: 280px 280px; gap: 16px; }

.life-card { position: relative; overflow: hidden; background: var(--ink); color: white; min-height: 180px; }

.life-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s; filter: brightness(0.72) saturate(0.72); }

.life-card:hover img { transform: scale(1.06); }

.life-card:first-child { grid-row: span 2; }

.life-card:nth-child(4) { grid-column: span 2; }

.life-overlay { position: absolute; inset: 0px; padding: 25px; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(0deg, rgba(7, 15, 12, 0.72), transparent 65%); }

.life-overlay span { font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gold-light); font-weight: bold; }

.life-overlay h3 { font-family: Georgia, serif; font-size: clamp(1.45rem, 2.5vw, 2.25rem); font-weight: 400; margin-top: 6px; }

.booking { position: relative; color: white; background: rgb(38, 58, 51); overflow: hidden; }

.booking::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(16, 30, 26, 0.94), rgba(16, 30, 26, 0.55)), url("https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2200&q=82") center center / cover; mix-blend-mode: normal; }

.booking-inner { position: relative; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 70px; align-items: end; }

.booking h2 { max-width: 690px; }

.booking-left .eyebrow { margin-bottom: 20px; }

.booking-left p { margin-top: 22px; color: rgb(214, 220, 216); line-height: 1.7; max-width: 500px; }

.booking-actions { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; }

.booking-info { border-left: 1px solid rgba(255, 255, 255, 0.3); padding-left: 42px; display: grid; gap: 24px; }

.booking-item small { display: block; font-size: 0.61rem; color: var(--gold-light); font-weight: bold; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 7px; }

.booking-item strong { font-family: Georgia, serif; font-size: 1.13rem; font-weight: 400; line-height: 1.35; }

.contact { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(45px, 10vw, 150px); align-items: start; }

.contact-intro .copy { margin-top: 25px; max-width: 360px; }

.contact-number { display: inline-flex; gap: 14px; align-items: center; margin-top: 38px; color: var(--ink); font-family: Georgia, serif; font-size: 1.45rem; border-bottom: 1px solid var(--gold); padding-bottom: 10px; }

.contact-number svg { color: var(--gold); width: 20px; }

form { background: rgb(255, 253, 249); padding: clamp(25px, 4vw, 45px); box-shadow: rgba(26, 38, 32, 0.07) 0px 12px 45px; }

.form-title { font-family: Georgia, serif; font-size: 1.75rem; font-weight: 400; margin-bottom: 29px; }

.field { position: relative; margin-bottom: 23px; }

.field label { display: block; font-size: 0.62rem; letter-spacing: 0.13em; font-weight: bold; text-transform: uppercase; color: rgb(112, 122, 117); margin-bottom: 8px; }

.field input, .field textarea { width: 100%; border-width: 0px 0px 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(203, 208, 203); border-image: initial; outline: 0px; background: transparent; padding: 8px 0px; color: var(--ink); border-radius: 0px; transition: border 0.2s; }

.field input:focus, .field textarea:focus { border-color: var(--gold); }

.field textarea { height: 72px; resize: vertical; }

.form-note { font-size: 0.72rem; color: rgb(123, 132, 127); margin-top: 17px; line-height: 1.55; }

.footer { background: var(--ink); color: white; padding: 34px max(5.5vw, 24px) 88px; display: flex; justify-content: space-between; gap: 20px; align-items: center; }

.footer .brand { font-size: 0.72rem; }

.footer p { font-size: 0.68rem; color: rgb(158, 169, 163); }

.reveal { opacity: 0; transform: translateY(25px); transition: opacity 0.75s, transform 0.75s; }

.reveal.visible { opacity: 1; transform: none; }

.mobile-bar { display: none; }

.modal { position: fixed; inset: 0px; z-index: 50; display: none; align-items: center; justify-content: center; padding: 22px; background: rgba(10, 20, 17, 0.7); backdrop-filter: blur(7px); }

.modal.active { display: flex; }

.modal-box { position: relative; background: var(--ivory); width: min(500px, 100%); padding: 42px; text-align: center; box-shadow: var(--shadow); }

.modal-box h3 { font-family: Georgia, serif; font-size: 2rem; font-weight: 400; margin: 12px 0px; }

.modal-box p { color: var(--muted); line-height: 1.65; }

.close { position: absolute; right: 14px; top: 10px; border: 0px; background: none; font-size: 26px; color: var(--ink); cursor: pointer; }

@media (max-width: 800px) {
  .nav { height: 68px; }
  .nav-links { display: none; }
  .menu-btn { display: block; }
  .nav.open { background: var(--ink); height: auto; align-items: flex-start; padding-top: 21px; padding-bottom: 21px; }
  .nav.open .nav-links { display: flex; position: absolute; top: 67px; left: 0px; width: 100%; background: var(--ink); padding: 12px 24px 24px; flex-direction: column; align-items: flex-start; gap: 19px; }
  .hero { padding-bottom: 104px; align-items: flex-end; }
  .hero-side { display: none; }
  .hero-image { background-position: 58% center; }
  .section { padding: 78px 24px; }
  .intro, .project-grid, .booking-inner, .contact { grid-template-columns: 1fr; gap: 38px; }
  .project-image { height: 390px; order: -1; }
  .location-top { display: block; margin-bottom: 32px; }
  .location-top .copy { margin-top: 20px; }
  .map-wrap { height: 440px; }
  .lifestyle-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 270px 190px 190px; gap: 10px; }
  .life-card:first-child { grid-area: auto / span 2; }
  .life-card:nth-child(4) { grid-column: span 2; }
  .booking-info { border-left: 0px; border-top: 1px solid rgba(255, 255, 255, 0.3); padding: 28px 0px 0px; grid-template-columns: 1fr 1fr; gap: 25px; }
  .footer { padding-bottom: 94px; flex-direction: column; align-items: flex-start; }
  .mobile-bar { display: grid; grid-template-columns: 1fr 1.15fr; position: fixed; z-index: 30; bottom: 0px; left: 0px; width: 100%; height: 64px; background: rgb(255, 253, 249); box-shadow: rgba(0, 0, 0, 0.13) 0px -5px 24px; }
  .mobile-bar a { display: flex; align-items: center; justify-content: center; font-size: 0.67rem; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase; }
  .mobile-bar a:first-child { color: var(--ink); border-right: 1px solid var(--line); }
  .mobile-bar a:last-child { background: var(--gold); color: var(--ink); }
}

@media (max-width: 460px) {
  .brand { font-size: 0.71rem; }
  .hero h1 { font-size: 3.1rem; }
  .hero-actions .button { width: 100%; }
  .booking-info { grid-template-columns: 1fr; }
  .lifestyle-grid { grid-template-rows: 245px 170px 170px; }
  .location-card { right: 15px; left: 15px; padding: 21px; }
  .map-marker { left: 66%; top: 38%; }
}
