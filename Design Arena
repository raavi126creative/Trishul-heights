  .project-visual { aspect-ratio: 16 / 10; max-height: 420px; }
  .lifestyle-grid { grid-template-columns: 1fr 1fr; }
  .lifestyle-wide { grid-column: span 2; }
  .booking-info { grid-template-columns: 1fr; gap: 28px; text-align: center; }
  .hero-content { padding-bottom: 120px; }
  .section { padding: 72px 0px; }
  .mobile-bar { display: flex; }
  .footer { padding-bottom: 100px; }
}

@media (max-width: 640px) {
  .container, .container-wide { padding: 0px 18px; }
  .hero-title { letter-spacing: 0.02em; }
