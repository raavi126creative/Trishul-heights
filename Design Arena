  .hero-actions .btn { width: 100%; }
  .lifestyle-grid { grid-template-columns: 1fr; }
  .lifestyle-wide { grid-column: span 1; min-height: 280px; }
  .lifestyle-card { aspect-ratio: 4 / 3; }
